#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=01

start_service() {
	local enabled
	local device_id
	local product_id
	local secret

	config_load 'tuya-esp-controllerd'
	config_get enabled device_sct 'enable' '0'
	config_get device_id device_sct 'device_id' ''
	config_get product_id device_sct 'product_id' ''
	config_get secret device_sct 'secret' ''

	if [ "$enabled" -eq 1 ]; then
		procd_open_instance
		procd_set_param command /usr/bin/tuya-esp-controllerd -p $product_id -d $device_id -s $secret
		procd_set_param pidfile /var/run/tuya-esp-controllerd.pid
		procd_set_param file /etc/config/tuya-esp-controllerd
		procd_set_param respawn 120 10 10
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "tuya-esp-controllerd"
}

reload_service() {
	stop
	start
}
