#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=01

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/esp-controller
    procd_set_param pidfile /var/run/esp-controller.pid
    procd_set_param file /etc/config/esp-controller
    procd_set_param respawn 120 10 10
    procd_close_instance
}

reload_service() {
	stop
	start
}
